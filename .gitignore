# Claude Code local state (agent worktrees, session scratch).
#
# Ignored by *contents* rather than as a directory, so that the one file meant to
# be shared can be re-included: git will not un-ignore a file whose parent
# directory is excluded, so `.claude/` followed by `!.claude/settings.json` would
# silently do nothing.
.claude/*
!.claude/settings.json

# WSL / Windows alternate-data-stream artifacts
*:Zone.Identifier

# Node
node_modules/
dist/

# Local env
.env
deploy/.env

# Generated by scripts/dev/up.sh — per-run DSN, random signing key, git root.
# Never commit: the DSN carries a port that only exists for one run.
.env.test
.adp-test/

# Terraform. State is kept in GCS (infra/dev/versions.tf), never on disk here;
# tfvars names a specific project and person and stays local.
#
# .terraform.lock.hcl is deliberately NOT ignored: it pins provider versions
# and their checksums, which is the same supply-chain property this project
# argues for everywhere else.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
