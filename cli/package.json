{
  "name": "@deduva/adp",
  "version": "0.7.0",
  "description": "The ADP CLI — intents, proposals, gates, evidence and undo against an ADP instance, plus `adp init` and `adp connect` for a repository that already exists.",
  "license": "MIT",
  "homepage": "https://github.com/DeDuva/adp#readme",
  "bugs": {
    "url": "https://github.com/DeDuva/adp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeDuva/adp.git",
    "directory": "cli"
  },
  "keywords": [
    "adp",
    "ai-agents",
    "provenance",
    "supply-chain-security",
    "sdlc",
    "git",
    "slsa",
    "in-toto",
    "devsecops",
    "mcp",
    "self-hosted",
    "forge",
    "github",
    "evidence"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "adp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
