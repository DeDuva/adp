# Postgres, used by both `postgres` and `server` services.
#
# NOTE: the host `postgres` here is the compose *service name* — this DSN only
# resolves from inside the compose network. Do not copy this file to
# `server/.env` and expect `npm run dev` to connect; it will not. For anything
# running on the host (local dev, `npm test`, conformance/run.sh) use the
# canonical local DSN instead, defined once in scripts/dev/config.sh:
#
#   postgres://adp:adp@localhost:5432/adp
#
# See docs/test-environment-automation.md (finding 5).
POSTGRES_USER=adp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=adp
DATABASE_URL=postgres://adp:change-me@postgres:5432/adp

# Where bare repos live inside the server container.
GIT_ROOT=/data/git

# Upper bound on a single git smart-HTTP request body (push packs), in bytes.
# Both request and response bodies are streamed to/from `git http-backend`,
# not buffered — this just guards against unbounded memory use, not throughput.
GIT_MAX_PACK_BYTES=524288000

# Server-held seed for the Ed25519 signing key used on (change, evidence,
# provenance) tuples. This is NOT a PEM keypair — core/signing.ts derives the
# actual Ed25519 private key deterministically via SHA-256(SIGNING_KEY), so
# any sufficiently random secret string works. Generate one with:
# openssl rand -hex 32
#
# Changing this changes the server's signing identity: DSSE envelopes record
# the public key as `keyid` (core/dsse.ts), so evidence signed under an old
# value stays attributable but no longer matches the current key.
SIGNING_KEY=change-me

# AES-256-GCM key protecting secrets at rest (core/mirror-crypto.ts): mirror
# credentials (a GitHub PAT), outbound webhook signing secrets, and the
# inbound mirror webhook secret. Required — server/src/config.ts validates it
# with no default, so the server exits 1 at boot if it is missing.
# openssl rand -hex 32
MIRROR_CREDENTIAL_KEY=change-me

# Public hostname `gh` and git clients will hit. Must be HTTPS in any
# non-local deployment — `gh` only takes the GHES /api/v3 path for a
# non-github.com host, and expects a real certificate.
PUBLIC_URL=https://adp.example.com

PORT=3000

# Instance-level land-policy floor (docs/pragmatic_mvp.md §1.5 item 2):
# admin-owned, non-bypassable by any repo's adp.yaml — a repo can only add
# requirements on top, never remove one of these. Comma-separated
# "gates_green" and/or "one_approval"; empty string means no floor at all.
LAND_POLICY_FLOOR=gates_green,one_approval
